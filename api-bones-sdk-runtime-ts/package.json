{
  "name": "@brefwiz/api-bones-sdk-runtime",
  "version": "0.1.0",
  "description": "Host-side runtime every generated Brefwiz SDK wrapper imports: list-call and error types, handle adapters, wasm loader helpers, error formatting and a live span sink into OpenTelemetry. It holds no decision logic.",
  "author": "Brefwiz Team",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "generate": "buf generate",
    "prebuild": "npm run generate",
    "build": "tsc",
    "pretest": "npm run generate",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "intl-messageformat": "^12.2.0"
  },
  "peerDependencies": {
    "@brefwiz/api-bones-otel": "^0.1.1",
    "@bufbuild/protobuf": "^2.2.0",
    "@opentelemetry/api": ">=1.9.0 <1.10.0"
  },
  "devDependencies": {
    "@brefwiz/api-bones-otel": "file:../api-bones-otel",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "registry": "https://git.brefwiz.com/api/packages/brefwiz/npm/",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
