{
  "name": "@brefwiz/api-bones-connect",
  "version": "0.9.1",
  "description": "Canonical Connect transport profiles for Brefwiz SDKs — shared policy core with browser and Node adapters",
  "author": "Brefwiz Team",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "embed-error-catalogs": "bin/embed-error-catalogs.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./web": {
      "import": "./dist/web.js",
      "types": "./dist/web.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "embed-catalogs": "node scripts/embed-catalogs.mjs",
    "prebuild": "npm run embed-catalogs",
    "pretest": "npm run embed-catalogs",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "peerDependencies": {
    "@brefwiz/api-bones-sdk-runtime": ">=0.3.0",
    "@brefwiz/spiffe-client": "^0.46.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@connectrpc/connect-web": {
      "optional": true
    },
    "@connectrpc/connect-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@brefwiz/api-bones-sdk-runtime": "file:../api-bones-sdk-runtime-ts",
    "@brefwiz/spiffe-client": "^0.46.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/validator": "^13.15.0"
  },
  "publishConfig": {
    "registry": "https://git.brefwiz.com/api/packages/brefwiz/npm/",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "dependencies": {
    "@fhir-toolkit/ucum": "^0.2.0",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "currency-codes": "^2.2.0",
    "intl-messageformat": "^12.2.0",
    "validator": "^13.15.15"
  }
}
